# Copy to .env and fill in. Never commit .env.
# Groq API key (used when PROVIDER=groq; the app also builds a Groq client at startup).
GROQ_API_KEY=
# Google Gemini API key (used when PROVIDER=gemini).
GEMINI_API_KEY=
# Which model provider audits claims: gemini or groq.
PROVIDER=gemini
# Shared secret between the Cloudflare Worker and the app (openssl rand -hex 32); leave empty locally.
PROXY_SECRET=
# 1 = refuse every request without PROXY_SECRET (production behind the Worker only); 0 locally.
REQUIRE_PROXY_SECRET=0
